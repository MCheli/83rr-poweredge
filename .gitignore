# Environment files and secrets
.env
*.env.local
*.env.backup
*.env.production
stack.env
**/stack.env
secrets/
**/secrets/
*.key
*.pem
*.p12
*.keystore

# Let's Encrypt certs are renewed in place on the server by
# scripts/renew-letsencrypt-certs.sh, so tracking them made every renewal show
# up as drift. The source of truth is ~/letsencrypt on the server; backup.sh
# copies both it and these files to the NAS nightly. Their keys (*.key) were
# never tracked, so a fresh clone already needed restoring from there.
infrastructure/nginx/certs/letsencrypt-*.crt

# Python
venv/
*.pyc
__pycache__/
.pytest_cache/

# Node.js / Nuxt
.nuxt/
node_modules/
.output/

# Logs (but not infrastructure/logs config)
/logs/
*.log

# Backups (ignore all except README)
backups/*
!backups/README.md

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Temporary files
*.tmp
*.bak
*~

# Claude Code
infrastructure/nginx/.htpasswd

# OpenClaw (all runtime data — secrets, credentials, workspace, agent state)
infrastructure/openclaw/openclaw-home/
infrastructure/openclaw/gogcli/

# ASA — GameUserSettings.ini contains ServerAdminPassword + ServerPassword
infrastructure/asa/config/GameUserSettings.ini
