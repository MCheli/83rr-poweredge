# Infrastructure Environment Configuration
# Copy to .env and customize for your environment

# ═════════════════════════════════════════════════════════════════════════════
# Environment Detection (optional - auto-detected if not set)
# ═════════════════════════════════════════════════════════════════════════════
# INFRASTRUCTURE_ENV=development  # or production

# ═════════════════════════════════════════════════════════════════════════════
# GitHub Container Registry Authentication (required for production)
# ═════════════════════════════════════════════════════════════════════════════
GITHUB_USERNAME=mcheli
GITHUB_TOKEN=your_github_token_here
# OR use Personal Access Token:
# GITHUB_PAT=your_personal_access_token

# ═════════════════════════════════════════════════════════════════════════════
# Application Configuration
# ═════════════════════════════════════════════════════════════════════════════
JUPYTERHUB_CRYPT_KEY=your-jupyterhub-secret-key
GRAFANA_ADMIN_PASSWORD=change-me-generate-with-openssl-rand
# flask-api /weather (https://home.openweathermap.org/api_keys). Leave empty
# for the demo data.
OPENWEATHER_API_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:pass@postgres:5432/dbname

# ═════════════════════════════════════════════════════════════════════════════
# Cloudflare DNS Management (required for automated DNS updates)
# ═════════════════════════════════════════════════════════════════════════════
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_EMAIL=your_cloudflare_email@example.com
# Domains managed by Cloudflare
CLOUDFLARE_DOMAINS=markcheli.com,ops.markcheli.com

# ═════════════════════════════════════════════════════════════════════════════
# Development vs Production Settings
# ═════════════════════════════════════════════════════════════════════════════
# Development: Services accessible via localhost ports
# Production: Services accessible via domain names through NGINX reverse proxy

# ═════════════════════════════════════════════════════════════════════════════
# Dependency-Track (docs/dependency-track.md)
# ═════════════════════════════════════════════════════════════════════════════
# Postgres password for deptrack-db (compose refuses to start without it):
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
DEPTRACK_DB_PASSWORD=change-me-generate-with-openssl-rand
# API key of the "sbom-scanner" team, written here by scripts/deptrack-setup.sh apply.
# Used by scripts/sbom-scan.sh (nightly cron).
DT_API_KEY=odt_replace-with-key-from-deptrack-setup
# Optional: GitHub token (no scopes needed) to also mirror GitHub Advisories.
# Leave empty to skip; OSV already includes GitHub's advisories.
DT_GITHUB_TOKEN=
# ntfy write-only token (user "alerts", topic "homelab"); already used by
# OpenSearch/Kuma. deptrack-setup.sh stores it as a DT secret for alerts, and
# sbom-scan.sh uses it for its failure summary.
NTFY_PUBLISH_TOKEN=tk_replace-with-ntfy-token
# API key of the "triage" team (VIEW_PORTFOLIO, VIEW_VULNERABILITY,
# VULNERABILITY_ANALYSIS), written here by `scripts/deptrack-setup.sh triage-key`.
# Used by the weekly security sweep to read findings and record analyses.
DT_TRIAGE_API_KEY=odt_replace-with-key-from-deptrack-setup-triage-key

# ═════════════════════════════════════════════════════════════════════════════
# Host networking
# ═════════════════════════════════════════════════════════════════════════════
# The server's LAN address. *.ops DNS records must point at it
# (scripts/test_infrastructure.py checks), and edge-tts (5050) and
# faster-whisper (5051) publish on it instead of 0.0.0.0, for the HeyClawy
# devices and Home Assistant. Compose refuses to run without it.
LOCAL_IP=192.0.2.10
