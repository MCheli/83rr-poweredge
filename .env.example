# Infrastructure Environment Configuration
# Copy to .env and customize for your environment

# ═════════════════════════════════════════════════════════════════════════════
# Environment Detection (optional - auto-detected if not set)
# ═════════════════════════════════════════════════════════════════════════════
# INFRASTRUCTURE_ENV=development  # or production

# ═════════════════════════════════════════════════════════════════════════════
# GitHub Container Registry Authentication (required for production)
# ═════════════════════════════════════════════════════════════════════════════
GITHUB_USERNAME=mcheli
GITHUB_TOKEN=your_github_token_here
# OR use Personal Access Token:
# GITHUB_PAT=your_personal_access_token

# ═════════════════════════════════════════════════════════════════════════════
# Application Configuration
# ═════════════════════════════════════════════════════════════════════════════
JUPYTERHUB_CRYPT_KEY=your-jupyterhub-secret-key
GRAFANA_ADMIN_PASSWORD=change-me-generate-with-openssl-rand

# ═════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:pass@postgres:5432/dbname

# ═════════════════════════════════════════════════════════════════════════════
# Cloudflare DNS Management (required for automated DNS updates)
# ═════════════════════════════════════════════════════════════════════════════
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_EMAIL=your_cloudflare_email@example.com
# Domains managed by Cloudflare
CLOUDFLARE_DOMAINS=markcheli.com,ops.markcheli.com

# ═════════════════════════════════════════════════════════════════════════════
# Development vs Production Settings
# ═════════════════════════════════════════════════════════════════════════════
# Development: Services accessible via localhost ports
# Production: Services accessible via domain names through NGINX reverse proxy     1	
     2	# ═════════════════════════════════════════════════════════════════════════════
     3	# Dependency-Track (docs/dependency-track.md)
     4	# ═════════════════════════════════════════════════════════════════════════════
     5	# Postgres password for deptrack-db (compose refuses to start without it):
     6	#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
     7	DEPTRACK_DB_PASSWORD=change-me-generate-with-openssl-rand
     8	# API key of the "sbom-scanner" team, printed once by scripts/deptrack-setup.sh.
     9	# Used by scripts/sbom-scan.sh (nightly cron).
    10	DT_API_KEY=odt_replace-with-key-from-deptrack-setup
    11	# Optional: GitHub token (no scopes needed) to also mirror GitHub Advisories.
    12	# Leave empty to skip; OSV already includes GitHub's advisories.
    13	DT_GITHUB_TOKEN=
    14	# ntfy write-only token (user "alerts", topic "homelab"); already used by
    15	# OpenSearch/Kuma. deptrack-setup.sh stores it as a DT secret for alerts, and
    16	# sbom-scan.sh uses it for its failure summary.
    17	NTFY_PUBLISH_TOKEN=tk_replace-with-ntfy-token
