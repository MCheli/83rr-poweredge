# Infrastructure Environment Configuration
# Copy to .env and customize for your environment

# ═════════════════════════════════════════════════════════════════════════════
# Environment Detection (optional - auto-detected if not set)
# ═════════════════════════════════════════════════════════════════════════════
# INFRASTRUCTURE_ENV=development  # or production

# ═════════════════════════════════════════════════════════════════════════════
# GitHub Container Registry Authentication (required for production)
# ═════════════════════════════════════════════════════════════════════════════
GITHUB_USERNAME=mcheli
GITHUB_TOKEN=your_github_token_here
# OR use Personal Access Token:
# GITHUB_PAT=your_personal_access_token

# ═════════════════════════════════════════════════════════════════════════════
# Application Configuration
# ═════════════════════════════════════════════════════════════════════════════
JUPYTERHUB_CRYPT_KEY=your-jupyterhub-secret-key
GRAFANA_ADMIN_PASSWORD=change-me-generate-with-openssl-rand
# flask-api /weather (https://home.openweathermap.org/api_keys). Leave empty
# for the demo data.
OPENWEATHER_API_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═════════════════════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:pass@postgres:5432/dbname

# ═════════════════════════════════════════════════════════════════════════════
# Cloudflare DNS Management (required for automated DNS updates)
# ═════════════════════════════════════════════════════════════════════════════
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_EMAIL=your_cloudflare_email@example.com
# Domains managed by Cloudflare
CLOUDFLARE_DOMAINS=markcheli.com,ops.markcheli.com

# ═════════════════════════════════════════════════════════════════════════════
# Development vs Production Settings
# ═════════════════════════════════════════════════════════════════════════════
# Development: Services accessible via localhost ports
# Production: Services accessible via domain names through NGINX reverse proxy

# ═════════════════════════════════════════════════════════════════════════════
# Dependency-Track (docs/dependency-track.md)
# ═════════════════════════════════════════════════════════════════════════════
# Postgres password for deptrack-db (compose refuses to start without it):
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
DEPTRACK_DB_PASSWORD=change-me-generate-with-openssl-rand
# API key of the "sbom-scanner" team, written here by scripts/deptrack-setup.sh apply.
# Used by scripts/sbom-scan.sh (nightly cron).
DT_API_KEY=odt_replace-with-key-from-deptrack-setup
# Optional: GitHub token (no scopes needed) to also mirror GitHub Advisories.
# Leave empty to skip; OSV already includes GitHub's advisories.
DT_GITHUB_TOKEN=
# ntfy write-only token (user "alerts", topic "homelab"); already used by
# OpenSearch/Kuma. deptrack-setup.sh stores it as a DT secret for alerts, and
# sbom-scan.sh uses it for its failure summary. Also required by compose for
# grafana (alerting contact points) and watchtower (ntfy:// notification URL),
# and read by scripts/cron-notify.sh (docs/OBSERVABILITY.md#alerting).
NTFY_PUBLISH_TOKEN=tk_replace-with-ntfy-token
# API key of the "triage" team (VIEW_PORTFOLIO, VIEW_VULNERABILITY,
# VULNERABILITY_ANALYSIS), written here by `scripts/deptrack-setup.sh triage-key`.
# Used by the weekly security sweep to read findings and record analyses.
DT_TRIAGE_API_KEY=odt_replace-with-key-from-deptrack-setup-triage-key

# ═════════════════════════════════════════════════════════════════════════════
# Host networking
# ═════════════════════════════════════════════════════════════════════════════
# The server's LAN address. *.ops DNS records must point at it
# (scripts/test_infrastructure.py checks).
LOCAL_IP=192.0.2.10

# ═════════════════════════════════════════════════════════════════════════════
# homelab-mcp: claude.ai connector (infrastructure/homelab-mcp/README.md)
# ═════════════════════════════════════════════════════════════════════════════
# Turns the homelab-mcp service on (it has compose profile "mcp"); leave unset until configured
# COMPOSE_PROFILES=mcp
# Google accounts allowed to sign in (comma-separated)
HOMELAB_MCP_ALLOWED_EMAILS=you@example.com
# Google OAuth "Web application" client; redirect URI https://mcp.markcheli.com/auth/callback
HOMELAB_MCP_GOOGLE_CLIENT_ID=
HOMELAB_MCP_GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32  (rotating it signs the connector out)
HOMELAB_MCP_JWT_SIGNING_KEY=
# Seafile: AI Context library > API Token, permission Read-Only
HOMELAB_MCP_SEAFILE_TOKEN=
# Optional: Mac mini session bus over the LAN (leave the target empty to turn it off).
# user@<mini LAN IP>; the mini's ~/.ssh/authorized_keys pins this key to bus-gateway's relay.py
HOMELAB_MCP_BUS_SSH_TARGET=
# base64 -w0 of the dedicated private key (ssh-keygen -t ed25519 -N '' -C homelab-mcp)
HOMELAB_MCP_BUS_SSH_KEY_B64=
# the mini's host public key, e.g. "ssh-ed25519 AAAA..." (cat /etc/ssh/ssh_host_ed25519_key.pub on the mini)
HOMELAB_MCP_BUS_SSH_HOST_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# knowledge: web reader for the AI Context notes vault (knowledge.markcheli.com)
# ═════════════════════════════════════════════════════════════════════════════
# Google OAuth "Web application" client. The same client as Tasks/Cookbook works once the
# redirect URI https://knowledge.markcheli.com/api/auth/google/callback is added to it.
KNOWLEDGE_GOOGLE_CLIENT_ID=
KNOWLEDGE_GOOGLE_CLIENT_SECRET=
# openssl rand -hex 32 for each. Rotating the JWT secret signs everyone out; rotating the
# pepper invalidates every kn_ API key. Production refuses the defaults.
KNOWLEDGE_JWT_SECRET=
KNOWLEDGE_API_KEY_PEPPER=
# The owner (sees everything, manages users) and extra Google accounts allowed to sign in
# (comma-separated; they start as viewers who see nothing until granted)
KNOWLEDGE_OWNER_EMAIL=you@example.com
KNOWLEDGE_ALLOWED_EMAILS=
# Host folder of the notes vault, mounted read-only at /vault (default /data/ai-context/notes)
# KNOWLEDGE_VAULT_DIR=/data/ai-context/notes

# ═════════════════════════════════════════════════════════════════════════════
# house-transcriber: indoor camera speech → AI Context (docs/house-transcriber.md)
# ═════════════════════════════════════════════════════════════════════════════
# Turns it on: add "transcriber" to COMPOSE_PROFILES (e.g. COMPOSE_PROFILES=mcp,transcriber)
# 1Password: Agents / "HA agent token"
HOUSE_TRANSCRIBER_HA_TOKEN=
# 1Password: Agents / "UniFi Protect API key" (Protect > Settings > Control Plane > Integrations)
HOUSE_TRANSCRIBER_PROTECT_API_KEY=
# Seafile: AI Context library > API Token, app "house-transcriber", permission Read-Write
HOUSE_TRANSCRIBER_SEAFILE_TOKEN=
# Optional overrides
# HOUSE_TRANSCRIBER_HA_URL=http://192.168.1.121:8123
# HOUSE_TRANSCRIBER_MODEL=large-v3-turbo

# ═════════════════════════════════════════════════════════════════════════════
# ha-auto-update: daily Home Assistant updates (docs/home-assistant-auto-update.md)
# ═════════════════════════════════════════════════════════════════════════════
# 1Password: Agents / "HA agent token" (admin long-lived token: update.install, backups)
HA_AUTO_UPDATE_TOKEN=
# 1Password: Agents / "Tasks API key" (files "auto-update failed" agent items)
HA_AUTO_UPDATE_TASKS_API_KEY=
# Optional: the Yellow on the LAN (default; keeps restarts off nginx/Cloudflare)
# HA_URL=http://192.168.1.121:8123
