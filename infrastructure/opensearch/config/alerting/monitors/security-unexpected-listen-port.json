{
  "type": "monitor",
  "monitor_type": "query_level_monitor",
  "name": "security-unexpected-listen-port",
  "enabled": true,
  "schedule": { "period": { "interval": 15, "unit": "MINUTES" } },
  "inputs": [
    {
      "search": {
        "indices": ["logs-homelab-*"],
        "query": {
          "size": 20,
          "query": {
            "bool": {
              "must": [
                { "term": { "event_type": "security_unexpected_port" } },
                { "range": { "@timestamp": { "gte": "now-15m" } } }
              ]
            }
          },
          "aggs": { "by_port": { "terms": { "field": "port", "size": 20 } } }
        }
      }
    }
  ],
  "triggers": [
    {
      "name": "unexpected-listen-port",
      "severity": "2",
      "condition": {
        "script": {
          "source": "ctx.results[0].hits.total.value > 0",
          "lang": "painless"
        }
      },
      "actions": [
        {
          "name": "ntfy-homelab",
          "destination_id": "ntfy-homelab",
          "message_template": {
            "source": "{\"topic\": \"homelab\", \"title\": \"[homelab] SECURITY: unexpected listening port(s)\", \"message\": \"Monitor: {{ctx.monitor.name}}\\nA TCP port is LISTENing that is not in scripts/emit_security_telemetry.sh ALLOWED_PORTS.\\n\\nPorts: {{#ctx.results.0.aggregations.by_port.buckets}}{{key}}({{doc_count}}) {{/ctx.results.0.aggregations.by_port.buckets}}\\n\\nIf you just added a service, add the port to the allowlist. Otherwise investigate:\\n  sudo ss -tlnp | grep -E ':(PORT) '\\n\", \"priority\": 4, \"tags\": [\"rotating_light\"]}",
            "lang": "mustache"
          },
          "throttle_enabled": true,
          "throttle": { "value": 360, "unit": "MINUTES" }
        }
      ]
    }
  ]
}
