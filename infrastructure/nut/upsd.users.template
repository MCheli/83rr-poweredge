# /etc/nut/upsd.users — managed by 83rr-poweredge infrastructure/nut/install.sh
# The one account: the local upsmon, as primary (it may set FSD and shut the
# UPS down). install.sh replaces __UPSMON_PASSWORD__ with a random password
# made on first install (kept on later runs) and puts the same value in
# upsmon.conf. The real password is never committed.
[upsmon]
    password = __UPSMON_PASSWORD__
    upsmon primary
