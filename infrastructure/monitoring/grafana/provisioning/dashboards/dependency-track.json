{
  "id": null,
  "uid": "dependency-track-trend",
  "title": "Dependency-Track trend",
  "description": "Portfolio totals recorded by scripts/sbom-scan.sh after each nightly scan (node-exporter textfile collector, logs/textfile/deptrack.prom). Unlike DT's own dashboard history, a point here is what was active when it was recorded. Older than Prometheus' 30-day retention: logs/deptrack-metrics.jsonl.",
  "tags": ["dependency-track", "security", "cve"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {"from": "now-30d", "to": "now"},
  "refresh": "1h",
  "panels": [
    {
      "id": 1,
      "title": "Critical",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "deptrack_portfolio_findings{severity=\"critical\"}", "legendFormat": "Critical"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "dark-red"}}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "High",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "deptrack_portfolio_findings{severity=\"high\"}", "legendFormat": "High"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "orange"}}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}
    },
    {
      "id": 3,
      "title": "Inherited risk score",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "deptrack_portfolio_inherited_risk_score", "legendFormat": "Risk"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "text"}}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0}
    },
    {
      "id": 4,
      "title": "Suppressed (FP / not affected)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "deptrack_portfolio_suppressed", "legendFormat": "Suppressed"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "text"}}},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0}
    },
    {
      "id": 5,
      "title": "KEV findings",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "deptrack_portfolio_kev", "legendFormat": "KEV"}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0}
    },
    {
      "id": 6,
      "title": "Last recorded",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "time() - deptrack_portfolio_last_update_timestamp_seconds", "legendFormat": "Age"}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 129600}]}}},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0}
    },
    {
      "id": 7,
      "title": "Findings by severity (active projects, unsuppressed)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "deptrack_portfolio_findings", "legendFormat": "{{severity}}"}],
      "fieldConfig": {
        "defaults": {"unit": "short", "min": 0, "custom": {"lineInterpolation": "stepAfter"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "critical"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "dark-red"}}]},
          {"matcher": {"id": "byName", "options": "high"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
          {"matcher": {"id": "byName", "options": "medium"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
          {"matcher": {"id": "byName", "options": "low"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
          {"matcher": {"id": "byName", "options": "unassigned"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "gray"}}]}
        ]
      },
      "options": {"tooltip": {"mode": "multi"}},
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 4}
    },
    {
      "id": 8,
      "title": "Inherited risk score",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "deptrack_portfolio_inherited_risk_score", "legendFormat": "Risk score"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineInterpolation": "stepAfter"}}},
      "gridPos": {"h": 9, "w": 8, "x": 16, "y": 4}
    },
    {
      "id": 9,
      "title": "Suppressed, projects, policy violations",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "deptrack_portfolio_suppressed", "legendFormat": "Suppressed"},
        {"expr": "deptrack_portfolio_projects", "legendFormat": "Projects"},
        {"expr": "deptrack_portfolio_vulnerable_projects", "legendFormat": "Vulnerable projects"},
        {"expr": "deptrack_portfolio_policy_violations", "legendFormat": "Policy violations"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"lineInterpolation": "stepAfter"}}},
      "options": {"tooltip": {"mode": "multi"}},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13}
    }
  ]
}
