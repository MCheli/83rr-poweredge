# Copy to infrastructure/ai-context/.env (gitignored). Folders live outside
# the repo checkout and are owned by the deploy user (uid/gid below).
AI_CONTEXT_NOTES_DIR=/data/ai-context/notes
AI_CONTEXT_RAW_DIR=/data/ai-context/raw
AI_CONTEXT_STATE_DIR=/data/ai-context/state
# Disposable copy of the notes vault that basic-memory indexes (and rewrites);
# refreshed by cron: rsync -a --delete --exclude .git --exclude .obsidian $AI_CONTEXT_NOTES_DIR/ $AI_CONTEXT_INDEX_COPY_DIR/
AI_CONTEXT_INDEX_COPY_DIR=/data/ai-context/state/basic-memory-copy
AI_CONTEXT_UID=1000
AI_CONTEXT_GID=1000
TZ=America/New_York
BASIC_MEMORY_LOG_LEVEL=INFO
