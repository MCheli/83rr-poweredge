# Copy to infrastructure/ai-context/.env (gitignored). Folders live outside
# the repo checkout and are owned by the deploy user (uid/gid below).
AI_CONTEXT_NOTES_DIR=/data/ai-context/notes
AI_CONTEXT_RAW_DIR=/data/ai-context/raw
AI_CONTEXT_STATE_DIR=/data/ai-context/state
AI_CONTEXT_UID=1000
AI_CONTEXT_GID=1000
TZ=America/New_York
BASIC_MEMORY_LOG_LEVEL=INFO
